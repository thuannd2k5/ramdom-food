{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-location": "~58.0.17",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node -r ./polyfill.js ./node_modules/expo/bin/cli start",
    "android": "node -r ./polyfill.js ./node_modules/expo/bin/cli start --android",
    "ios": "node -r ./polyfill.js ./node_modules/expo/bin/cli start --ios",
    "web": "node -r ./polyfill.js ./node_modules/expo/bin/cli start --web",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/expo/bin/cli';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');if(!c.includes('URL.parse')){fs.writeFileSync(p, 'if(!URL.parse){URL.parse=(u,b)=>{try{return new URL(u,b)}catch{return null}}};\\n'+c)}}\""
  },
  "private": true
}
